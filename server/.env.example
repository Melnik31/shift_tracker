# Copy to .env and fill in. Never commit the real .env (it's gitignored).
# Production values live in Render's environment variable dashboard, not
# in a checked-in file — see ../DEPLOYING.md.

# Postgres connection string the app uses at runtime. Local dev: the
# docker-compose Postgres (`docker compose up -d`). Staging/production:
# Supabase's *pooled* connection string (port 6543) with `?pgbouncer=true`
# appended — see ../DEPLOYING.md (required, not optional: without it,
# Prisma's prepared statements randomly collide across PgBouncer's pooled
# connections under real traffic).
DATABASE_URL="postgresql://shifttracker:shifttracker@localhost:5432/shifttracker_dev"
# Only used by `prisma migrate`/`db push` — needs a *direct*, non-pooled
# connection (port 5432 on Supabase). Same value as DATABASE_URL locally,
# where there's no pooler at all.
DIRECT_URL="postgresql://shifttracker:shifttracker@localhost:5432/shifttracker_dev"

# Signs the session cookie. Any long random string works for local dev;
# generate a real one for staging/production (e.g. `openssl rand -base64 32`)
# and never reuse it across environments.
SESSION_SECRET="dev-secret-change-me"

PORT=4000

# Set to "production" on staging and production deploys — gates the
# session cookie's secure/sameSite flags (see app.ts) and the seed script's
# guardrails. Leave unset for local dev.
NODE_ENV=development

# Comma-separated list of origins allowed to call this API with credentials
# (see app.ts's CORS config), e.g.:
#   ALLOWED_ORIGINS="https://app.example.com,https://staging.example.com"
# Defaults to the Vite dev server's origin if unset.
ALLOWED_ORIGINS="http://localhost:5173"

# Supabase project settings -> Data API. Service role key bypasses Row Level
# Security — server-side only, never expose it to the client.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Storage bucket file uploads go into (see lib/storage.ts) — must already
# exist in the Supabase project (Storage tab, or via the API) before the
# app can upload to it.
SUPABASE_STORAGE_BUCKET="shift-attachments"
