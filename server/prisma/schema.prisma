generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Tenancy ──────────────────────────────────────────────────────────────

model Workspace {
  id             String   @id @default(uuid())
  name           String
  workspaceCode  String   @unique
  operationalStart String @default("06:00") // HH:mm, configurable matrix window
  operationalEnd   String @default("22:00")
  onboardingStep   Int    @default(0) // 0 = not started, 3 = complete
  createdAt      DateTime @default(now())

  adminUsers  AdminUser[]
  employees   Employee[]
  campuses    Campus[]
  sections    Section[]
  shifts      Shift[]
  payrollPeriods    PayrollPeriod[]
  payrollAdjustments PayrollAdjustment[]
  payrollPeriodReopens PayrollPeriodReopen[]
}

// A Workspace subdivision that scopes DIRECTOR/SENIOR_LEAD_INSTRUCTOR access (ADMIN/CEO see
// every Campus in the workspace — see campusScopeFor in src/lib/campusScope.ts).
// Every Workspace always has exactly one Campus with isDefault=true: created
// at signup for new workspaces, and backfilled as "Main Campus" for pre-
// existing ones (see prisma/backfillDefaultCampus.ts). Section creation falls
// back to this default Campus when the caller doesn't specify one, so the
// existing single-campus UI keeps working unchanged.
model Campus {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  sortOrder   Int      @default(0)
  isDefault   Boolean  @default(false)
  // Deactivated campuses are hidden from "create new" pickers (new Sections,
  // new Director/SLI assignments) but existing Sections/admins under them are
  // untouched — see routes/campuses.ts. Can't deactivate the default campus;
  // another must be set default first.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id])
  sections   Section[]
  adminUsers AdminUser[]

  @@index([workspaceId])
}

// SQLite has no native Prisma enum support (see dataType/statusValue note
// below), so role is a plain string constrained to a union type in the TS
// layer — see ROLES in src/types.ts. Valid values: COACH | DIRECTOR | SENIOR_LEAD_INSTRUCTOR | ADMIN | CEO.
// Existing rows default to ADMIN on migration; reassign manually afterward.
model AdminUser {
  id           String   @id @default(uuid())
  workspaceId  String
  email        String
  passwordHash String
  role         String   @default("ADMIN")
  // Null = unrestricted (ADMIN/CEO see every Campus in the workspace). Set =
  // scoped to exactly that one Campus (DIRECTOR/SENIOR_LEAD_INSTRUCTOR) — see campusScopeFor.
  campusId     String?
  // Deactivated admins can't log in (see routes/auth.ts) — soft-delete
  // rather than a hard DELETE, since PayrollAdjustment/PayrollPeriodReopen
  // hold non-nullable createdBy FKs to this table (see routes/admins.ts).
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  campus    Campus?   @relation(fields: [campusId], references: [id])
  createdAdjustments PayrollAdjustment[]
  createdReopens PayrollPeriodReopen[]

  @@unique([workspaceId, email])
  @@index([campusId])
}

model Employee {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  pinHash     String
  role        String   @default("Employee")
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  assignments CellStaffAssignment[]
  payrollAdjustments PayrollAdjustment[]

  @@index([workspaceId])
}

// ── Layout engine: Section -> Location -> SubRow ────────────────────────
// These three models ARE the entire layout engine. No industry-specific
// naming is permitted here or anywhere downstream — all display labels
// are admin-entered strings stored in `name`/`label`.

model Section {
  id          String   @id @default(uuid())
  workspaceId String
  campusId    String
  name        String
  sortOrder   Int      @default(0)

  workspace Workspace  @relation(fields: [workspaceId], references: [id])
  campus    Campus     @relation(fields: [campusId], references: [id])
  locations Location[]

  @@index([workspaceId])
  @@index([campusId])
}

model Location {
  id        String   @id @default(uuid())
  sectionId String
  name      String
  sortOrder Int      @default(0)

  section Section  @relation(fields: [sectionId], references: [id])
  subRows SubRow[]

  @@index([sectionId])
}

// SQLite has no native enum support in Prisma; dataType/statusValue are
// plain strings constrained to a union type in the TS layer (see src/types.ts).
// Valid dataType values: BADGE | STAFF | TEXT | LINK | FILE | STATUS

model SubRow {
  id         String   @id @default(uuid())
  locationId String
  label      String
  dataType   String
  sortOrder  Int      @default(0)
  config     String   @default("{}") // type-specific JSON, e.g. badge color palette

  location   Location    @relation(fields: [locationId], references: [id])
  shifts     Shift[]
  cellValues CellValue[]

  @@index([locationId])
}

// ── Time blocks & cell data ──────────────────────────────────────────────

model Shift {
  id          String   @id @default(uuid())
  workspaceId String
  subRowId    String
  date        String   // YYYY-MM-DD
  startTime   String   // HH:mm
  endTime     String   // HH:mm
  sessionType String?  // descriptive only, see SESSION_TYPES in src/types.ts; nullable so existing shifts are unaffected
  cancelled   Boolean  @default(false)

  workspace  Workspace   @relation(fields: [workspaceId], references: [id])
  subRow     SubRow      @relation(fields: [subRowId], references: [id])
  cellValues CellValue[]

  @@index([workspaceId])
  @@index([subRowId, date])
}

// Valid statusValue values: SCHEDULED | IN_PROGRESS | COMPLETED

model CellValue {
  id         String @id @default(uuid())
  shiftId    String
  subRowId   String

  textValue   String?
  badgeLabel  String?
  badgeColor  String?
  statusValue String?
  linkUrl     String?

  shift Shift  @relation(fields: [shiftId], references: [id])
  subRow SubRow @relation(fields: [subRowId], references: [id])

  staffAssignments CellStaffAssignment[]
  fileUploads      FileUpload[]

  @@unique([shiftId, subRowId])
}

model CellStaffAssignment {
  id          String @id @default(uuid())
  cellValueId String
  employeeId  String

  cellValue CellValue @relation(fields: [cellValueId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])

  @@unique([cellValueId, employeeId])
}

model FileUpload {
  id          String   @id @default(uuid())
  cellValueId String
  filename    String
  url         String
  uploadedAt  DateTime @default(now())

  cellValue CellValue @relation(fields: [cellValueId], references: [id])
}

// ── Payroll review ───────────────────────────────────────────────────────
// Admin-only subsystem (requireRole('ADMIN')). Once a period is APPROVED,
// shift data it covers is locked (see rejectIfLocked in src/lib/payrollLock.ts)
// — corrections go through PayrollAdjustment instead of mutating history.

model PayrollPeriod {
  id          String    @id @default(uuid())
  workspaceId String
  start       String    // YYYY-MM-DD inclusive
  end         String    // YYYY-MM-DD inclusive
  status      String    @default("OPEN") // OPEN | REVIEWED | APPROVED — see PAYROLL_PERIOD_STATUSES in src/types.ts
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
  approvedAt  DateTime?

  workspace   Workspace              @relation(fields: [workspaceId], references: [id])
  adjustments PayrollAdjustment[]
  reopens     PayrollPeriodReopen[]

  @@index([workspaceId])
}

// Audit trail for reopening an APPROVED period (sets it back to OPEN). This
// is for fixing test/incomplete data before a period is finalized for real —
// distinct from PayrollAdjustment, which corrects genuinely locked history
// without reopening it. Same audit shape as PayrollAdjustment (actor,
// timestamp, required reason), minus the per-employee fields that don't apply.
model PayrollPeriodReopen {
  id          String   @id @default(uuid())
  workspaceId String
  periodId    String
  reason      String
  createdBy   String   // AdminUser id
  createdAt   DateTime @default(now())

  workspace      Workspace     @relation(fields: [workspaceId], references: [id])
  period         PayrollPeriod @relation(fields: [periodId], references: [id])
  createdByAdmin AdminUser     @relation(fields: [createdBy], references: [id])

  @@index([workspaceId])
  @@index([periodId])
}

model PayrollAdjustment {
  id           String   @id @default(uuid())
  workspaceId  String
  employeeId   String
  periodId     String
  deltaMinutes Int
  reason       String
  createdBy    String   // AdminUser id
  createdAt    DateTime @default(now())

  workspace      Workspace     @relation(fields: [workspaceId], references: [id])
  employee       Employee      @relation(fields: [employeeId], references: [id])
  period         PayrollPeriod @relation(fields: [periodId], references: [id])
  createdByAdmin AdminUser     @relation(fields: [createdBy], references: [id])

  @@index([workspaceId])
  @@index([periodId])
  @@index([employeeId])
}
