# Copy to .env and fill in for local dev. Leave unset locally — Vite's dev
# server proxy (vite.config.ts) already forwards /api to localhost:4000, so
# a relative path works fine until the client and API are on different
# domains. Staging/production values live in Vercel's environment variable
# dashboard, not in a checked-in file — see ../DEPLOYING.md.

# Bare origin of the deployed API, e.g. "https://api.example.com" — no
# trailing /api, that's appended automatically (see client/src/lib/api.ts).
# Only needed once the client (Vercel) and API (Render) are on different
# origins.
# VITE_API_URL="https://api.example.com"
